{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Static assets only: no script runs, Cloudflare serves the files in dist/.
  "name": "oxabl-web",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status, so crawlers do not
    // index the home page under every URL.
    "not_found_handling": "404-page"
  }
}
