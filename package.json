{
  "name": "oxabl-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "start": "serve dist -s -l tcp://0.0.0.0:${PORT:-3000}",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "keywords:generate": "node scripts/generate-keyword-data.mjs",
    "keywords:check": "node scripts/generate-keyword-data.mjs --check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
