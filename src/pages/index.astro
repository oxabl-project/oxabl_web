---
import { HexHero } from "@/components/HexHero"
import Logo from "@/components/Logo.astro"
import Navbar from "@/components/Navbar.astro"
import PipelineDiagram from "@/components/PipelineDiagram.astro"
import { RunIt } from "@/components/RunIt"
import SpeedTable from "@/components/SpeedTable.astro"
import Surfaces from "@/components/Surfaces.astro"
import { TryOxabl } from "@/components/TryOxabl"
import keywordCounts from "@/data/keyword-counts.json"
import keywords from "@/data/keywords.json"
import Layout from "@/layouts/main.astro"
---

<Layout>
  <Navbar />

  <main>
    <section aria-labelledby="masthead-title" class="px-4 sm:px-6">
      <div
        class="mx-auto my-12 flex w-full max-w-7xl flex-col border border-rule md:my-[72px] md:min-h-[min(78vh,760px)]"
      >
        <div class="grid flex-1 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
          <div
            class="flex flex-col items-start justify-center gap-6 border-rule bg-paper p-6 sm:p-12 md:border-r md:p-6 lg:p-12 xl:p-[72px]"
          >
            <Logo size="lg" />
            <h1
              id="masthead-title"
              class="max-w-[12ch] text-display font-medium"
            >
              ABL developers deserve modern toolchains.
            </h1>
            <p class="max-w-[60ch] text-body text-ink-muted">
              oxabl brings fast parsing, semantic analysis, and linting to the
              ABL codebases that still run essential businesses.
            </p>

            <div class="w-full max-w-[36rem] border-t border-rule-strong pt-6">
              <p class="font-chrome text-chrome text-ink-muted uppercase">
                Install
              </p>
              <code
                class="mt-6 block overflow-x-auto font-code text-code whitespace-nowrap text-ink"
                >single binary install coming soon</code
              >
            </div>
          </div>

          <div
            class="relative hidden min-h-[360px] overflow-hidden bg-screen md:block md:min-h-[480px]"
          >
            <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
            <HexHero client:media="(min-width: 768px)" />
          </div>
        </div>
      </div>
    </section>

    <section
      id="playground"
      aria-label="Interactive ABL playground"
      class="border-t border-rule px-4 sm:px-6"
    >
      <div class="mx-auto w-full max-w-7xl py-12 md:py-[72px]">
        <TryOxabl client:visible />
      </div>
    </section>

    <section
      aria-labelledby="vocabulary-title"
      class="border-t border-rule px-4 sm:px-6"
    >
      <div class="mx-auto w-full max-w-7xl py-12">
        <div
          class="grid items-end gap-6 md:grid-cols-[minmax(0,2fr)_minmax(16rem,1fr)]"
        >
          <p class="font-chrome text-display text-ink" aria-hidden="true">
            {keywordCounts.total}
          </p>
          <div class="pb-6">
            <h2
              id="vocabulary-title"
              class="font-chrome text-chrome text-ink-muted uppercase"
            >
              {keywordCounts.total} keywords, functions and statements the lexer knows
            </h2>
          </div>
        </div>

        <figure class="mt-6 border-t border-rule-strong pt-6">
          <figcaption
            class="mb-6 font-chrome text-chrome text-ink-muted uppercase"
          >
            Reserved-keyword subset / {keywords.length} entries
          </figcaption>
          <div
            class="vocabulary-field h-[288px] overflow-hidden"
            role="img"
            aria-label={`A dense field containing the ${keywords.length}-entry reserved-keyword subset.`}
          >
            <p
              class="text-justify font-code text-code text-ink [text-align-last:justify]"
              aria-hidden="true"
            >
              {keywords.join(" ")}
            </p>
          </div>
        </figure>
      </div>
    </section>

    <section
      aria-labelledby="what-title"
      class="border-t border-rule px-4 sm:px-6"
    >
      <div class="mx-auto w-full max-w-7xl py-[72px]">
        <h2
          id="what-title"
          class="text-center font-wordmark text-heading text-ink lowercase"
        >
          what is oxabl
        </h2>
        <p class="mt-6 text-heading text-ink-muted">
          The answer to performant, native ABL tooling. Starting with formatting
          and linting, for the CLI, an LSP, or your CI workflows.
        </p>
        <Surfaces class="mt-12" />
      </div>
    </section>

    <section
      aria-labelledby="pipeline-title"
      class="border-t border-rule px-4 sm:px-6"
    >
      <div class="mx-auto w-full max-w-7xl py-[72px]">
        <h2 id="pipeline-title" class="mb-6 text-heading font-medium">
          How it works
        </h2>
        <PipelineDiagram />
      </div>
    </section>

    <section
      id="speed"
      aria-labelledby="speed-title"
      class="border-t border-rule px-4 sm:px-6"
    >
      <div class="mx-auto w-full max-w-7xl py-[72px]">
        <h2 id="speed-title" class="mb-6 text-heading font-medium">
          Benchmarks
        </h2>
        <SpeedTable />
      </div>
    </section>

    <section
      id="run"
      aria-labelledby="run-title"
      class="border-t border-rule px-4 sm:px-6"
    >
      <div class="mx-auto w-full max-w-7xl py-[72px]">
        <h2 id="run-title" class="mb-6 text-heading font-medium">Install</h2>
        <RunIt client:load />
      </div>
    </section>
  </main>

  <footer class="border-t border-rule px-4 sm:px-6">
    <div
      class="mx-auto flex min-h-[96px] w-full max-w-7xl flex-wrap items-center gap-x-6 gap-y-6 py-6 font-chrome text-chrome text-ink-muted uppercase"
    >
      <a
        class="hover:text-ink"
        href="https://github.com/oxabl-project/oxabl"
        target="_blank"
        rel="noopener noreferrer"
      >
        Contribute on GitHub
      </a>
      <span>MIT licence</span>
      <a
        class="hover:text-ink"
        href="https://crates.io/crates/oxabl"
        target="_blank"
        rel="noopener noreferrer"
      >
        crates.io
      </a>
      <span class="sm:ml-auto">
        Unofficial · no affiliation with Progress Software
      </span>
    </div>
  </footer>
</Layout>
