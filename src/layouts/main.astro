---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "oxabl — high-performance tooling for ABL",
  description = "Blazingly fast developer tools for Progress ABL, written in Rust. Lexer, parser, semantic analysis, lint. Unofficial and unaffiliated.",
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="oklch(0.17 0.004 80)"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="oklch(0.985 0.002 80)"
      media="(prefers-color-scheme: light)"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      ;(() => {
        const t = localStorage.getItem("theme")
        if (t === "dark") document.documentElement.classList.add("dark")
      })()
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
