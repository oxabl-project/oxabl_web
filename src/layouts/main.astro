---
import "@/styles/global.css"
import {
  DESCRIPTION,
  DOCS,
  OG_IMAGE_ALT,
  OG_IMAGE_PATH,
  OG_IMAGE_SIZE,
  REPO,
  SITE,
  SITE_NAME,
  TITLE,
} from "@/lib/seo"

interface Props {
  title?: string
  description?: string
  // A page that must stay out of the index: no canonical, no structured data.
  noindex?: boolean
}

const {
  title = TITLE,
  description = DESCRIPTION,
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, SITE).href
const image = new URL(OG_IMAGE_PATH, SITE).href

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      name: SITE_NAME,
      url: `${SITE}/`,
      alternateName: "oxabl.org",
      description,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE}/#software`,
      name: SITE_NAME,
      url: `${SITE}/`,
      description,
      applicationCategory: "DeveloperApplication",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      license: "https://opensource.org/licenses/MIT",
      softwareHelp: { "@type": "WebSite", url: DOCS },
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${SITE}/#source`,
      name: SITE_NAME,
      codeRepository: REPO,
      programmingLanguage: "Rust",
      license: "https://opensource.org/licenses/MIT",
      targetProduct: { "@id": `${SITE}/#software` },
    },
  ],
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="oklch(0.17 0.004 80)"
      media="(prefers-color-scheme: dark)"
      data-theme-color="dark"
    />
    <meta
      name="theme-color"
      content="oklch(0.985 0.002 80)"
      media="(prefers-color-scheme: light)"
      data-theme-color="light"
    />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <!-- .ico first: Safari never loads an SVG favicon and needs the raster. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Inline and un-bundled on purpose: this has to settle the theme before
      // the first paint, or the reader sees a flash of the wrong material.
      ;(() => {
        let mode = "system"
        try {
          const stored = localStorage.getItem("theme")
          if (stored === "light" || stored === "dark") mode = stored
        } catch (_) {
          // No storage access; the system preference is a fine answer.
        }
        const dark =
          mode === "dark" ||
          (mode === "system" &&
            matchMedia("(prefers-color-scheme: dark)").matches)
        const root = document.documentElement
        if (dark) root.classList.add("dark")
        root.dataset.themeMode = mode
        root.style.colorScheme = dark ? "dark" : "light"
      })()
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
