---
import Logo from "@/components/Logo.astro"
import MobileMenu from "@/components/MobileMenu.astro"
import ThemeControl from "@/components/ThemeControl.astro"

// `hidden sm:flex` on the links-and-theme wrapper resolves to the
// `display: flex` it has always had from 640px up, so the bar above that width
// is untouched. Below it those two things move into the menu panel — the theme
// control is the widest object on the bar and the reason the wordmark and the
// links no longer fit beside it.
//
// `sm:hidden` on the menu control and the panel script's `(min-width: 40rem)`
// are the same breakpoint written twice, and have to be changed together.
---

<nav class="border-b border-rule bg-paper" aria-label="Primary navigation">
  <div
    class="mx-auto flex min-h-[72px] w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6"
  >
    <a href="/" aria-label="oxabl home">
      <Logo />
    </a>

    <div
      class="hidden flex-wrap items-center justify-end gap-x-4 gap-y-3 sm:flex"
    >
      <div
        class="flex items-center gap-2 font-chrome text-chrome uppercase sm:gap-4"
      >
        <a class="text-ink-muted hover:text-ink" href="#playground">
          playground
        </a>
        <span class="text-rule-strong" aria-hidden="true">·</span>
        <a
          class="text-ink-muted hover:text-ink"
          href="https://github.com/oxabl-project/oxabl"
          target="_blank"
          rel="noopener noreferrer"
        >
          github
        </a>
        <span class="text-rule-strong" aria-hidden="true">·</span>
        <a
          class="text-ink-muted hover:text-ink"
          href="https://crates.io/crates/oxabl"
          target="_blank"
          rel="noopener noreferrer"
        >
          crates
        </a>
      </div>

      <ThemeControl />
    </div>

    <MobileMenu class="sm:hidden" />
  </div>
</nav>
