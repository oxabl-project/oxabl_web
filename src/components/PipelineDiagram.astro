---
import MobileCollapse from "@/components/MobileCollapse.astro"
import PipelineNode from "@/components/PipelineNode.astro"

type CrateNode = {
  name: string
  caption: string
}

// A spine step is one crate, or a set of crates that sit side by side at the
// same point in the pass.
type SpineStep = CrateNode | CrateNode[]

// One definition per heading, consumed by both the canvas and the stacked
// rendering below `md`. The two are deliberately separate DOM subtrees, so a
// heading retyped in one and not the other would drift silently -- nothing in
// the build compares them.
const headings = {
  spine: "Spine",
  sourceIn: "Source text in",
  analysisOut: "Analysis out",
  analyses: "Strict analyses / what the strict lint groups read",
  surfaces: "Surfaces",
  surfacesDetail: "Depend on oxabl; the rest sit beneath it",
  build: "Build",
  buildDetail: "Beneath oxabl build: graph, plan, workers and cache",
  foundation: "Foundation",
  foundationDetail: "Shared types / files / style / generation",
} as const

const analyses: CrateNode[] = [
  {
    name: "oxabl_scope",
    caption:
      "Buffer scopes, transaction blocks and lock modes per unit, as the OpenEdge compiler assigns them, for Progress ABL",
  },
  {
    name: "oxabl_effects",
    caption:
      "Database effects per unit, likely index per record read, and transitive summaries over the call graph, for Progress ABL",
  },
  {
    name: "oxabl_handles",
    caption:
      "Lifetimes of dynamic objects (handles, persistent procedures, MEMPTRs) per unit, for Progress ABL",
  },
  {
    name: "oxabl_nulls",
    caption:
      "Unknown values and records a failed FIND may leave missing, per unit, for Progress ABL",
  },
]

const spine: SpineStep[] = [
  {
    name: "oxabl_lexer",
    caption: "Tokenizer for Progress ABL source code",
  },
  {
    name: "oxabl_parser",
    caption: "Parser for Progress ABL source code",
  },
  {
    name: "oxabl_preprocessor",
    caption:
      "Preprocessor for ABL source code: include expansion, &IF evaluation, and preprocessor variable tracking",
  },
  {
    name: "oxabl_schema",
    caption: "Progress OpenEdge .df schema parser and model",
  },
  {
    name: "oxabl_semantic",
    caption:
      "Semantic analysis for Progress ABL: symbol table, scope tree, resolution, and types",
  },
  {
    name: "oxabl_index",
    caption:
      "Cross-file fact extraction and the batch workspace index for oxabl",
  },
  {
    name: "oxabl_flow",
    caption:
      "Control-flow graphs with ABL block semantics, plus a dataflow framework, for Progress ABL",
  },
  analyses,
  {
    name: "oxabl_lint",
    caption: "Lint rules for Progress ABL built on the oxabl_semantic model",
  },
  {
    name: "oxabl_analyze",
    caption: "JSON dump + analyze CLI wiring for the oxabl semantic model",
  },
]

const surfaces: CrateNode[] = [
  {
    name: "oxabl",
    caption: "High-performance tooling suite for Progress ABL",
  },
  {
    name: "oxabl_lsp",
    caption:
      "stdio LSP server surfacing oxabl parse/lint/preprocessor diagnostics live in an editor",
  },
  {
    name: "oxabl_wasm",
    caption:
      "Thin WebAssembly client for the shared oxabl analysis and formatting pipelines",
  },
  {
    name: "oxabl_daemon",
    caption:
      "Long-lived oxabl session core: one salsa instance per workspace root, serving several clients",
  },
]

const sharedSurfaceLayer: CrateNode[] = [
  {
    name: "oxabl_formatter",
    caption:
      "Layout-only formatting engine for Progress ABL, built on the oxabl fidelity substrate",
  },
  {
    name: "oxabl_pipeline",
    caption:
      "Shared lint and format pipelines over one resolved oxabl configuration",
  },
  {
    name: "oxabl_daemon_protocol",
    caption:
      "Wire types and contract version for the oxabl daemon's oxabl/* methods",
  },
]

const build: CrateNode[] = [
  {
    name: "oxabl_build",
    caption:
      "The oxabl build tool: graph store, incremental refresh, planner, AVM worker pool and worker protocol",
  },
  {
    name: "oxabl_build_remote",
    caption:
      "The remote cache of oxabl build: an ArtifactCache over the oxabl-cache client",
  },
]

const foundation: CrateNode[] = [
  {
    name: "oxabl_ast",
    caption: "AST node definitions for the oxabl ABL parser",
  },
  {
    name: "oxabl_common",
    caption: "Shared utilities for the oxabl ABL tooling suite",
  },
  {
    name: "oxabl_workspace",
    caption:
      "Workspace configuration, file system abstraction, and file discovery for the oxabl ABL tooling suite",
  },
  {
    name: "oxabl_style",
    caption:
      "ABL style guide — typed, configurable formatting and diagnostic rules for the oxabl toolchain",
  },
  {
    name: "oxabl_codegen",
    caption: "Code generation tool for oxabl lexer keywords and atoms",
  },
]

const crateCount =
  spine.flat().length +
  surfaces.length +
  sharedSurfaceLayer.length +
  build.length +
  foundation.length
const sequence = (index: number) => String(index + 1).padStart(2, "0")
const count = (n: number) => `${n} crate${n === 1 ? "" : "s"}`

// What a closed group says it holds, below `md`.
const groupSummaries = {
  spine: `Source text in, analysis out, in ${spine.length} ordered steps: lex, parse, preprocess, schema, semantics, index, control flow, strict analyses, lint, analyze.`,
  surfaces:
    "What you run: the CLI, the language server, this page's playground and the session daemon, over shared lint, format and protocol crates.",
  build:
    "Incremental builds: dependency graph, plan, the OpenEdge worker pool and the remote compile cache.",
  foundation:
    "Shared AST, utilities, workspace configuration, style rules and keyword generation.",
}
---

<figure
  aria-labelledby="pipeline-title"
  aria-describedby="pipeline-description"
>
  <p id="pipeline-description" class="sr-only">
    {spine.length} ordered steps form the spine, from source text to analysis; step
    {sequence(spine.indexOf(analyses))} is the {analyses.length} strict analyses the
    strict lint groups run on. {surfaces.length} client surfaces consume the shared
    pipeline, with {sharedSurfaceLayer.length} shared crates beneath them. {
      build.length
    } crates make up the build tool, and
    {foundation.length} foundation crates support the system. All
    {crateCount} crate names link to their crates.io pages; oxabl is the one a consumer
    depends on directly.
  </p>

  <div class="hidden overflow-x-auto border border-rule-strong md:block">
    <div class="pipeline-canvas">
      <div class="pipeline-spine-heading pipeline-group-heading">
        <span>{headings.spine}</span>
        <span>{headings.sourceIn}</span>
      </div>

      <div class="pipeline-spine">
        {
          spine.map((crate, index) => (
            <>
              {index > 0 && (
                <svg
                  class="pipeline-connector pipeline-spine-connector"
                  viewBox="0 0 768 24"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <line x1="384" y1="0" x2="384" y2="18" />
                  <polygon points="380,16 388,16 384,24" />
                </svg>
              )}
              <div class="pipeline-spine-row">
                <span class="pipeline-sequence">{sequence(index)}</span>
                {Array.isArray(crate) ? (
                  <div class="pipeline-spine-set">
                    <span class="pipeline-spine-set__heading">
                      {headings.analyses}
                    </span>
                    {crate.map((member) => (
                      <PipelineNode {...member} />
                    ))}
                  </div>
                ) : (
                  <PipelineNode {...crate} />
                )}
              </div>
            </>
          ))
        }
      </div>

      <div class="pipeline-analysis-out">
        <span>{headings.analysisOut}</span>
      </div>

      <div class="pipeline-group-heading pipeline-group-heading--ruled">
        <span>{headings.surfaces}</span>
        <span>{headings.surfacesDetail}</span>
      </div>

      <div class="pipeline-surface-row">
        {surfaces.map((crate) => <PipelineNode {...crate} />)}
      </div>

      <svg
        class="pipeline-connector pipeline-surface-connectors"
        viewBox="0 0 1200 72"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M 600 72 V 36 H 150 V 8 M 600 36 H 450 V 8 M 600 36 H 750 V 8 M 600 36 H 1050"
        ></path>
        <polygon points="150,0 146,8 154,8"></polygon>
        <polygon points="450,0 446,8 454,8"></polygon>
        <polygon points="750,0 746,8 754,8"></polygon>
        <path d="M 1050 72 V 8"></path>
        <polygon points="1050,0 1046,8 1054,8"></polygon>
      </svg>

      <div class="pipeline-shared-row">
        <PipelineNode {...sharedSurfaceLayer[0]} />
        <PipelineNode {...sharedSurfaceLayer[1]} />
        <PipelineNode {...sharedSurfaceLayer[2]} />
        <svg
          class="pipeline-connector pipeline-formatter-connector"
          viewBox="0 0 24 16"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="0" y1="8" x2="16" y2="8"></line>
          <polygon points="24,8 16,4 16,12"></polygon>
        </svg>
      </div>

      <div class="pipeline-group-heading pipeline-group-heading--ruled">
        <span>{headings.build}</span>
        <span>{headings.buildDetail}</span>
      </div>

      <div class="pipeline-build-row">
        {build.map((crate) => <PipelineNode {...crate} />)}
      </div>

      <div class="pipeline-group-heading pipeline-group-heading--ruled">
        <span>{headings.foundation}</span>
        <span>{headings.foundationDetail}</span>
      </div>

      <div class="pipeline-foundation-row">
        {foundation.map((crate) => <PipelineNode {...crate} />)}
      </div>
    </div>
  </div>

  <div class="pipeline-mobile border border-rule-strong md:hidden">
    <MobileCollapse
      label={`${headings.spine} / ${count(spine.flat().length)}`}
      summary={groupSummaries.spine}
    >
      <div class="pipeline-mobile-heading">
        <span>{headings.sourceIn}</span>
      </div>

      <div class="pipeline-mobile-stack">
        {
          spine.map((crate, index) => (
            <>
              {index > 0 && (
                <div class="pipeline-mobile-connector" aria-hidden="true" />
              )}
              <div class="pipeline-mobile-step">
                <span class="pipeline-mobile-sequence">
                  {sequence(index)}
                  {Array.isArray(crate) && ` / ${headings.analyses}`}
                </span>
                {Array.isArray(crate) ? (
                  <div class="pipeline-mobile-set">
                    {crate.map((member) => (
                      <PipelineNode {...member} />
                    ))}
                  </div>
                ) : (
                  <PipelineNode {...crate} />
                )}
              </div>
            </>
          ))
        }
      </div>

      <div class="pipeline-mobile-out">
        <span>{headings.analysisOut}</span>
      </div>
    </MobileCollapse>

    <MobileCollapse
      class="border-t border-rule-strong"
      label={`${headings.surfaces} / ${count(surfaces.length + sharedSurfaceLayer.length)}`}
      summary={groupSummaries.surfaces}
    >
      <div class="pipeline-mobile-heading">
        <span>{headings.surfacesDetail}</span>
      </div>
      <div class="pipeline-mobile-group">
        {surfaces.map((crate) => <PipelineNode {...crate} />)}
        {sharedSurfaceLayer.map((crate) => <PipelineNode {...crate} />)}
      </div>
    </MobileCollapse>

    <MobileCollapse
      class="border-t border-rule-strong"
      label={`${headings.build} / ${count(build.length)}`}
      summary={groupSummaries.build}
    >
      <div class="pipeline-mobile-heading">
        <span>{headings.buildDetail}</span>
      </div>
      <div class="pipeline-mobile-group">
        {build.map((crate) => <PipelineNode {...crate} />)}
      </div>
    </MobileCollapse>

    <MobileCollapse
      class="border-t border-rule-strong"
      label={`${headings.foundation} / ${count(foundation.length)}`}
      summary={groupSummaries.foundation}
    >
      <div class="pipeline-mobile-heading">
        <span>{headings.foundationDetail}</span>
      </div>
      <div class="pipeline-mobile-group">
        {foundation.map((crate) => <PipelineNode {...crate} />)}
      </div>
    </MobileCollapse>
  </div>
</figure>
