          {
            label: "Proparse (Consultingwerk 5.1.0)",
            bench: "compare.sh --threads 1",
            value: 864,
            display: "864 MB",
            threads: 1,
          },
          {
            label: "Proparse (Riverside 3.11.1)",
            bench: "compare.sh --threads 1",
            value: 1864,
            display: "1,864 MB",
            threads: 1,
          },
          {
            label: "oxabl",
            bench: "compare.sh --threads 16",
            value: 304,
            display: "304 MB",
            threads: 16,
          },
          {
            label: "Proparse (Riverside 3.11.1)",
            bench: "compare.sh --threads 16",
            value: 8580,
            display: "8,580 MB",
            threads: 16,
          },
        ],
