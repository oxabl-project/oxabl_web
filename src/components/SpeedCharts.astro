---
// The speed block (DESIGN.md, "The speed block"): one ruled bar chart for each
// thing a developer measures. Every figure is a measured result; `bench` names
// the benchmark in the oxabl repository that produced it. Lower is better.
type Bar = {
  label: string
  bench: string
  value: number
  display: string
  note?: string
  // Shown as a tag beside the label, because a 1-thread and a 16-thread run
  // share one chart and must not be read as the same kind of run.
  threads?: number
}

// A group has its own scale and unit. Groups split one chart only where one
// scale would hide the smaller figures; bars inside a group always share one.
type Group = {
  heading?: string
  unit: string
  bars: Bar[]
}

type Chart = {
  id: string
  title: string
  caption: string
  reference?: { value: number; label: string }
  groups: Group[]
}

const failedNone = "0 of 10,386 files failed"

const charts: Chart[] = [
