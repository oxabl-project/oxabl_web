            value: 165.5,
            display: "166 s",
            note: `${failedNone} · one thread only: its settings are process-wide`,
            threads: 1,
          },
          {
            label: "Proparse (Riverside 3.11.1)",
            bench: "compare.sh --threads 1",
            value: 260.2,
            display: "260 s",
            note: failedNone,
            threads: 1,
          },
          {
            label: "oxabl",
            bench: "compare.sh --threads 16",
            value: 2.2,
            display: "2.2 s",
            note: failedNone,
            threads: 16,
          },
          {
            label: "Proparse (Riverside 3.11.1)",
            bench: "compare.sh --threads 16",
            value: 85.5,
            display: "86 s",
            note: failedNone,
            threads: 16,
          },
        ],
      },
    ],
  },
  {
    id: "memory",
    title: "Memory",
    caption:
      "Peak resident memory of the process, as the operating system counts it.",
    groups: [
