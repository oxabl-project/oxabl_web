    ],
  },
]

// The scale of a group starts at zero and ends a little past its largest
// figure or the chart's reference line, so neither touches the edge.
function scaleOf(group: Group, reference?: Chart["reference"]): number {
  const top = Math.max(
    ...group.bars.map((bar) => bar.value),
    reference?.value ?? 0
  )
  return top * 1.08
}

function percent(value: number, scale: number): string {
  return `${((value / scale) * 100).toFixed(2)}%`
}

// A reference line in the right half of a chart takes its label on its left,
// so the label stays inside the chart.
function labelLeft(value: number, scale: number): boolean {
  return value / scale > 0.5
}

// The label sits in flow beside the line, so a long label wraps on a phone
// instead of leaving the chart.
function labelPad(value: number, scale: number): string {
  const share = (value / scale) * 100
  return labelLeft(value, scale)
    ? `padding-right: calc(${(100 - share).toFixed(2)}% + 0.75rem)`
    : `padding-left: calc(${share.toFixed(2)}% + 0.75rem)`
}

function threadTag(threads: number): string {
  return threads === 1 ? "1 thread" : `${threads} threads`
}

// The columns of every row. The reference label and the reference line use
// them too, so the line lands at the same x as the bars in every row.
const columns =
  "grid gap-3 px-4 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-6"
const rowGrid = `${columns} md:items-center`
---

<div class="space-y-[72px]">
  {
    charts.map((chart) => (
      <figure aria-labelledby={`speed-${chart.id}`}>
        <h3 id={`speed-${chart.id}`} class="text-heading font-medium">
          {chart.title}
        </h3>
        <p class="mt-2 text-body text-ink-muted">{chart.caption}</p>
        <div class="mt-6 border border-rule-strong">
          {chart.groups.map((group) => {
            const scale = scaleOf(group, chart.reference)
            const reference = chart.reference
            return (
              <div class="border-b border-rule-strong last:border-b-0">
                <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-rule px-4 py-3 font-chrome text-chrome text-ink-muted uppercase">
                  <span>{group.heading ?? "Lower is better"}</span>
                  <span class="shrink-0">
                    {group.heading
                      ? `Lower is better · ${group.unit}`
                      : group.unit}
                  </span>
                </div>
                <div class="relative">
                  {reference && (
                    <div
                      class={`${columns} pointer-events-none absolute inset-0 hidden md:grid`}
                      aria-hidden="true"
                    >
                      <div />
                      <div class="flex gap-4">
                        <div class="relative flex-1">
                          <div
                            class="absolute inset-y-0 w-0.5 bg-ink"
                            style={`left: ${percent(reference.value, scale)}`}
                          />
                        </div>
                        <div class="w-24 shrink-0" />
                      </div>
                    </div>
                  )}
                  {reference && (
                    <div class={`${rowGrid} pt-4`} aria-hidden="true">
                      <div class="hidden md:block" />
                      <div class="flex items-center gap-4">
                        <div class="relative flex-1 pb-4">
                          <div
                            class="absolute top-0 -bottom-4 w-0.5 bg-ink md:hidden"
                            style={`left: ${percent(reference.value, scale)}`}
                          />
                          <p
                            class={`font-chrome text-chrome text-ink uppercase ${labelLeft(reference.value, scale) ? "text-right" : ""}`}
                            style={labelPad(reference.value, scale)}
                          >
                            {reference.label}
                          </p>
                        </div>
                        <div class="w-24 shrink-0" />
                      </div>
                    </div>
                  )}
                  <ul>
                    {group.bars.map((bar) => (
                      <li
                        class={`${rowGrid} border-b border-rule py-6 last:border-b-0`}
                      >
                        <div>
                          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-body text-ink">
                            <span>{bar.label}</span>
                            {bar.threads && (
                              <span class="border border-ink px-2 py-0.5 font-chrome text-chrome text-ink uppercase">
                                {threadTag(bar.threads)}
                              </span>
                            )}
                          </p>
                          <p class="font-code text-code wrap-anywhere text-ink-muted">
                            {bar.bench}
                          </p>
                          {bar.note && (
                            <p class="font-code text-code text-ink-muted">
                              {bar.note}
                            </p>
                          )}
                        </div>
                        <div class="flex items-center gap-4">
                          <div class="relative h-6 flex-1">
                            <div
                              class="absolute inset-y-0 left-0 border border-rule-strong"
                              style={`width: ${percent(bar.value, scale)}`}
                            />
                            {reference && (
                              <div
                                class="absolute -inset-y-3 w-0.5 bg-ink md:hidden"
                                style={`left: ${percent(reference.value, scale)}`}
                                aria-hidden="true"
                              />
                            )}
                          </div>
                          <p class="w-24 shrink-0 text-right font-code text-code text-ink">
                            {bar.display}
                          </p>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
                {reference && (
                  <p class="sr-only">Reference line: {reference.label}</p>
                )}
              </div>
            )
          })}
        </div>
      </figure>
    ))
  }

  <p class="font-chrome text-chrome text-ink-muted uppercase">
    Measured 2026-11-27 · <a
      href="https://github.com/oxabl-project/oxabl/commit/9370c9450673352675179d5759a561c1db122808"
      >oxabl 9370c94</a
    > · Intel Core i7-11700 · 8 cores / 16 threads · 32 GiB RAM · Linux · Rust 1.100.0
    · every input is synthetic or committed in the oxabl repository
  </p>
</div>
