          {
            label: "Autocomplete inside an expression, in a 10,000-line file",
            bench: "completion/request_stale/expression",
            value: 0.21,
            display: "0.21 ms",
          },
          {
            label: "Check a 3,385-line file again after a keystroke",
            bench: "daemon_cycle/warm_single_edit_cycle",
            value: 1.5,
            display: "1.5 ms",
          },
          {
            label: "Go to definition",
            bench: "navigation/definitions",
            value: 2.7,
            display: "2.7 ms",
          },
          {
            label: "Autocomplete a RUN target in a folder of 20,000 programs",
            bench: "completion/fresh/run_large",
            value: 6.6,
            display: "6.6 ms",
          },
          {
            label:
              "Refresh errors, highlighting, hints, outline and links after an edit",
            bench: "daemon_cycle/features_on_one_revision",
            value: 7.9,
            display: "7.9 ms",
          },
        ],
      },
    ],
  },
  {
    id: "references",
    title: "Find references",
    caption:
      "Every reference of a class and its 70 methods, across 2,000 programs that use it.",
    reference: {
      value: 100,
      label: "100 ms · a response stops feeling instant",
    },
    groups: [
      {
        unit: "ms",
        bars: [
          {
            label: "Find the references of a class and all 70 of its methods",
            bench: "references/search_every_lens_of_a_class",
            value: 38,
            display: "38 ms",
          },
        ],
      },
    ],
  },
  {
    id: "format-lint",
    title: "Format & Lint Speed",
    caption:
      "From the command line, on one program and on a 10,386-file workspace.",
    groups: [
      {
        heading: "One 3,385-line program with two include files",
        unit: "ms",
        bars: [
          {
            label: "Format",
            bench: "format/file_end_to_end",
            value: 1.7,
            display: "1.7 ms",
          },
          {
            label: "Lint",
            bench: "check/file",
            value: 3.1,
            display: "3.1 ms",
          },
        ],
      },
      {
        heading: "10,386 files, 4.07 million lines, 16 threads",
        unit: "s",
        bars: [
          {
            label: "Check the formatting of every file",
            bench: "scripts/bench/cli.sh format-ws",
            value: 0.42,
            display: "0.42 s",
            threads: 16,
          },
          {
            label: "Lint every file",
            bench: "scripts/bench/cli.sh check-ws",
            value: 6.2,
