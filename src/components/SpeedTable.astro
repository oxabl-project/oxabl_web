---
// One definition per column, consumed by both the desktop table and the mobile
// stack. The two renderings are deliberately separate DOM subtrees, so a label
// retyped in one and not the other would drift silently -- there is no build
// error for a heading that disagrees with itself. `face` carries the type
// treatment each column has always had.
type Column = {
  key: "lines" | "bytes" | "time" | "benchmark" | "measures"
  label: string
  face: string
  wrapAnywhere?: boolean
}

const columns: Column[] = [
  { key: "lines", label: "Lines", face: "font-chrome text-chrome text-ink" },
  { key: "bytes", label: "Bytes", face: "font-chrome text-chrome text-ink" },
  { key: "time", label: "Time", face: "font-code text-code text-ink-muted" },
  {
    key: "benchmark",
    label: "Benchmark id",
    face: "font-code text-code text-ink",
    // Only the stacked rendering needs this. The desktop table is 1024px wide
    // and the id has always fit; the 420px mobile column is where an unbroken
    // `daemon_cycle/cold_open` would otherwise push the box past the viewport.
    wrapAnywhere: true,
  },
  { key: "measures", label: "Measures", face: "text-body text-ink-muted" },
]

const rows = [
  {
    fixture: "resources/bench_preprocessor_pipeline.abl",
    lines: "50",
    bytes: "1,538",
    time: "0.05249 ms",
    benchmark: "parser/pipeline_with_includes",
    measures: "preprocess + lex + parse",
  },
  {
    fixture: "resources/bench_keywords.abl",
    lines: "632",
    bytes: "17,303",
    time: "0.23587 ms",
    benchmark: "parser/full_program",
    measures: "lex + parse, full program",
  },
  {
    fixture: "crates/oxabl_schema/fixtures/sp2k.df",
    lines: "2,654",
    bytes: "58,198",
    time: "0.32278 ms",
    benchmark: "schema/load_files:sp2k",
    measures: ".df schema load",
  },
  {
    fixture: "resources/lsp_bench.p",
    lines: "3,385",
    bytes: "129,286",
    time: "2.9132 ms",
    benchmark: "daemon_cycle/cold_open",
    measures: "fresh DB, full diagnostics",
  },
  {
    fixture: "generator replay: 90× sp2k with renamed tables",
    lines: "not recorded",
    bytes: "5,251,930",
    time: "5.5024 ms",
    benchmark: "schema/load_files:5mb_merged",
    measures: "schema parse at scale",
  },
]
---

<figure>
  <figcaption
    class="mb-6 flex flex-wrap justify-between gap-3 font-chrome text-chrome text-ink-muted uppercase"
  >
    <span>
      bench_*.abl: committed synthetic / sp2k.df: vendored public Riverside
      Software fixture
    </span>
    <span>generated row: derived by replaying the benchmark generator</span>
  </figcaption>

  <div class="hidden overflow-x-auto border border-rule-strong md:block">
    <table class="w-full min-w-[1024px] border-collapse text-left">
      <thead>
        <tr
          class="border-b border-rule-strong font-chrome text-chrome text-ink-muted uppercase"
        >
          <th scope="col" class="px-4 py-6 font-normal">Fixture</th>
          {
            columns.map(({ label }) => (
              <th
                scope="col"
                class="border-l border-rule px-4 py-6 font-normal"
              >
                {label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-rule last:border-b-0">
              <th
                scope="row"
                class="px-4 py-6 font-code text-code font-normal text-ink"
              >
                {row.fixture}
              </th>
              {columns.map(({ key, face }) => (
                <td class={`border-l border-rule px-4 py-6 ${face}`}>
                  {row[key]}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="px-6 md:hidden">
    <div class="mx-auto w-full max-w-[420px] border border-rule-strong">
      {
        rows.map((row) => (
          <div class="border-b border-rule px-4 py-6 last:border-b-0">
            <p class="font-code text-code wrap-anywhere text-ink">
              {row.fixture}
            </p>
            <dl class="mt-6 space-y-6">
              {columns.map(({ key, label, face, wrapAnywhere }) => (
                <div>
                  <dt class="font-chrome text-chrome text-ink-muted uppercase">
                    {label}
                  </dt>
                  <dd class={wrapAnywhere ? `${face} wrap-anywhere` : face}>
                    {row[key]}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </div>

  <p class="mt-6 font-chrome text-chrome text-ink-muted uppercase">
    Measured 2026-08-14 · <a
      href="https://github.com/oxabl-project/oxabl/commit/9a668c90427d9ddd4caa7ce1df52f6a8003adfd6"
      >oxabl 9a668c9</a
    > · Intel Core i7-11700 · 8 cores / 16 threads · 32 GiB RAM · Fedora Linux · Rust
    1.97.1
  </p>
</figure>
