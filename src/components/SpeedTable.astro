---

<figure>
  <figcaption
    class="mb-6 flex flex-wrap justify-between gap-3 font-chrome text-chrome text-ink-muted uppercase"
  >
    <span>
      bench_*.abl: committed synthetic / sp2k.df: vendored public Riverside Software fixture
    </span>
    <span>generated row: derived by replaying the benchmark generator / timings not measured</span>
  </figcaption>

  <div class="overflow-x-auto border border-rule-strong">
    <table class="w-full min-w-[1024px] border-collapse text-left">
      <thead>
        <tr
          class="border-b border-rule-strong font-chrome text-chrome text-ink-muted uppercase"
        >
          <th scope="col" class="px-4 py-6 font-normal">Fixture</th>
          <th scope="col" class="border-l border-rule px-4 py-6 font-normal"
            >Lines</th
          >
          <th scope="col" class="border-l border-rule px-4 py-6 font-normal"
            >Bytes</th
          >
          <th scope="col" class="border-l border-rule px-4 py-6 font-normal"
            >Time</th
          >
          <th scope="col" class="border-l border-rule px-4 py-6 font-normal"
            >Benchmark id</th
          >
          <th scope="col" class="border-l border-rule px-4 py-6 font-normal"
            >Measures</th
          >
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-rule last:border-b-0">
              <th
                scope="row"
                class="px-4 py-6 font-code text-code font-normal text-ink"
              >
                {row.fixture}
              </th>
              <td class="border-l border-rule px-4 py-6 font-chrome text-chrome text-ink">
                {row.lines}
              </td>
              <td class="border-l border-rule px-4 py-6 font-chrome text-chrome text-ink">
                {row.bytes}
              </td>
              <td class="border-l border-rule px-4 py-6 font-code text-code text-ink-muted">
                {row.time}
              </td>
              <td class="border-l border-rule px-4 py-6 font-code text-code text-ink">
                {row.benchmark}
              </td>
              <td class="border-l border-rule px-4 py-6 text-body text-ink-muted">
                {row.measures}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>
